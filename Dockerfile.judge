FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=0555 phase.py /opt/judge/phase.py
LABEL leetkob.judge.protocol="1"
ENV PATH=/usr/bin:/bin HOME=/work LANG=C.UTF-8 TMPDIR=/work
USER 65534:65534
WORKDIR /work
ENTRYPOINT ["/usr/bin/python3", "-I", "/opt/judge/phase.py"]
