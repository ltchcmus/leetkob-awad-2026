# Backend configuration. No real credentials belong in this template.
# Node does not auto-load .env: use node --env-file=.env <entrypoint>.
HOST=127.0.0.1
PORT=3000
# Use the same explicit absolute persistent database path for API and worker.
# Leave DATABASE_PATH unset to use the API default; an empty value is not a default.
# DATABASE_PATH=
DEMO_AUTH_TOKEN=
# Optional trusted absolute server-side authentication module path.
# AUTH_ADAPTER_MODULE=

# Offline by default. Production worker model-on requires durable guards.
MODEL_OFF=1
LLM_PRIMARY=gemini
LLM_FALLBACK=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FREE_VERIFIED_MODEL=
GEMINI_RPM=
GEMINI_RPD=
GEMINI_TPM=
GEMINI_CONCURRENCY=
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3.1-pro
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FREE_VERIFIED_MODEL=
NVIDIA_RPM=
NVIDIA_RPD=
NVIDIA_TPM=
NVIDIA_CONCURRENCY=

# Free-only; application caps are not provider account quota declarations.
LLM_ALLOW_PAID=false
LLM_LAB_BUDGET_USD=0
LLM_TIMEOUT_MS=30000
LLM_MAX_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_LAB_MAX_CALLS=
LLM_LAB_MAX_TOKENS=

# Worker: set trusted absolute module and immutable approved image digest.
# WORKER_ADAPTER_MODULE=
# SANDBOX_JUDGE_IMAGE=
WORKER_CONCURRENCY=1
WORKER_LEASE_MS=30000
WORKER_POLL_MS=250
WORKER_ADAPTER_TIMEOUT_MS=300000
